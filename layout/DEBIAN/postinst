#!/bin/sh
set -eu
case "${1:-}" in configure) ;; *) exit 0 ;; esac
prefix=''
launchctl='/bin/launchctl'
[ -x "$prefix/bin/launchctl" ] && launchctl="$prefix/bin/launchctl"
[ -x "$prefix/usr/bin/launchctl" ] && launchctl="$prefix/usr/bin/launchctl"
domain='system'
if "$launchctl" print user/foreground >/dev/null 2>&1; then domain='user/foreground'; fi
bootout_label() {
  label="$1"
  [ "$domain" = user/foreground ] && "$launchctl" bootout "user/foreground/$label" 2>/dev/null || true
  "$launchctl" bootout "system/$label" 2>/dev/null || true
}
runtime="$prefix/var/mobile/Library/MemTrim"
mkdir -p "$runtime"
chown 501:501 "$runtime"
chmod 700 "$runtime"
# Validate both executables before stopping an already-running original daemon.
"$prefix/usr/libexec/memtrimd" --configure
addon_ready=1
if ! "$prefix/usr/libexec/memtrim-autorecovery" --configure; then
  addon_ready=0
  echo 'MemTrim: automatic companion unavailable; original service will still start.' >&2
fi
bootout_label com.crctdd.memtrim.autorecovery
bootout_label com.crctdd.memtrim.daemon
original_plist="$prefix/Library/LaunchDaemons/com.crctdd.memtrim.daemon.plist"
chmod 644 "$original_plist"
"$launchctl" bootstrap "$domain" "$original_plist"
if ! "$launchctl" print "$domain/com.crctdd.memtrim.daemon" >/dev/null; then
  echo 'MemTrim: original daemon was not registered.' >&2
  exit 1
fi
"$launchctl" kickstart "$domain/com.crctdd.memtrim.daemon"
if [ "$addon_ready" -eq 1 ]; then
  addon_plist="$prefix/Library/LaunchDaemons/com.crctdd.memtrim.autorecovery.plist"
  chmod 644 "$addon_plist"
  if ! "$launchctl" bootstrap "$domain" "$addon_plist" ||
     ! "$launchctl" print "$domain/com.crctdd.memtrim.autorecovery" >/dev/null; then
    echo 'MemTrim: automatic companion could not register; disabled, check status in Settings.' >&2
  else
    "$launchctl" kickstart "$domain/com.crctdd.memtrim.autorecovery" ||
      echo 'MemTrim: companion failed to start; check status in Settings.' >&2
  fi
fi
# No respring, foreground app launch, or optimization request is forced here.
